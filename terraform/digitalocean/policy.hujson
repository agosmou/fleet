// The tailnet policy. Applying it (`just plan`, `just up`) replaces what the
// admin console holds; edit here, never there.
//
// Shape: people's devices are trusted, machines are not. A tagged node is
// a machine identity: your devices may reach it, but it may start a
// connection only where a grant names the tag as src. tag:server is the
// src of exactly one grant, the backup path, so a compromised server can
// start nothing else: not a connection to a laptop, a phone, or another
// server. Replies to connections people open still flow (the filter is
// stateful).
//
// No addresses or login names here: this repository is public. Rules
// name tags and autogroups only.
{
	"tagOwners": {
		// Machines that run services (droplets, spectre). No key expiry.
		"tag:server": ["autogroup:admin"],
		// Machines that only receive backups (the Pi 4 with an SSD). They
		// run an append-only restic rest-server and start nothing.
		"tag:backup": ["autogroup:admin"],
	},

	"grants": [
		// Your own devices (laptop, phone, Mac mini): everything, both ways.
		{"src": ["autogroup:member"], "dst": ["autogroup:self"], "ip": ["*"]},

		// Your devices to the machines: everything. Inbound from your own
		// devices is not the risk; a machine reaching out is.
		{"src": ["autogroup:member"], "dst": ["tag:server", "tag:backup"], "ip": ["*"]},

		// The one path a server may open: restic's rest-server on the
		// backup machine, append-only, so a compromised server can add
		// snapshots but never read a shell or delete old ones.
		{"src": ["tag:server"], "dst": ["tag:backup"], "ip": ["tcp:8000"]},
	],

	// Tailscale SSH: your devices into your own devices, re-authenticated
	// ("check"). Tagged machines use OpenSSH over the tailnet instead.
	"ssh": [
		{
			"action": "check",
			"src":    ["autogroup:member"],
			"dst":    ["autogroup:self"],
			"users":  ["autogroup:nonroot", "root"],
		},
	],

	// Checked on every save; a policy that breaks one is refused. They
	// name tags only (no addresses in a public repo), so "a server cannot
	// reach a laptop" is guaranteed by the grants above having no other
	// tag:server src, not by a test.
	"tests": [
		{
			"src":    "tag:server",
			"accept": ["tag:backup:8000"],
			"deny":   ["tag:backup:22", "tag:server:22", "tag:server:8080"],
		},
		{
			"src":  "tag:backup",
			"deny": ["tag:server:22", "tag:server:8080", "tag:backup:8000"],
		},
	],
}
