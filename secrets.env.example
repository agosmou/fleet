# Copy to secrets.env (gitignored) and fill in. direnv exports these when
# you cd into the repository; terraform and its providers read them by
# name, TF_VAR_* become terraform input variables. Keep the same three
# values in a Bitwarden secure note named "fleet secrets.env".

# DigitalOcean -> API -> Tokens -> Generate New Token, scopes: read + write.
DIGITALOCEAN_TOKEN=

# Tailscale admin console -> Settings -> Trust credentials -> OAuth client.
# Scopes: Keys: Auth Keys (write) with tag:server; Policy File (write);
# Devices: Core (write) so `just forget` can remove a destroyed machine's
# node. Terraform mints a single-use birth key per droplet with this and
# manages the policy file.
TAILSCALE_OAUTH_CLIENT_ID=
TAILSCALE_OAUTH_CLIENT_SECRET=

# ag's password on new machines, as a HASH, never the password itself:
#   openssl passwd -6      <- type the password; it prints a ~100-char line
#                             starting $6$ ; paste that whole line inside
#                             the quotes. Linux stores passwords this way.
TF_VAR_ag_passwd_hash=''
