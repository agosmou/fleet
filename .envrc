# direnv: entering this directory loads the tools (flake.nix devShell) and
# the secrets. `direnv allow` once after cloning or after editing this file.
use flake
# Tokens for terraform and its providers. The file is gitignored; copy
# secrets.env.example to start.
dotenv_if_exists secrets.env
# doctl reads a differently named variable than the terraform provider.
export DIGITALOCEAN_ACCESS_TOKEN="${DIGITALOCEAN_TOKEN:-}"
